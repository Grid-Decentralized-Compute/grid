{
  "name": "grid-mcp",
  "license": "MIT",
  "version": "0.1.0",
  "mcpName": "io.github.Grid-Decentralized-Compute/grid",
  "type": "module",
  "description": "Grid for AI agents: run swarm jobs on a decentralized GPU market with a wallet. An MCP server and a command line.",
  "homepage": "https://gridcompute.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grid-Decentralized-Compute/grid.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/Grid-Decentralized-Compute/grid/issues",
  "keywords": ["mcp", "model-context-protocol", "gpu", "compute", "swarm", "ethereum", "robinhood-chain", "agents"],
  "bin": {
    "grid": "dist/grid-cli.mjs",
    "grid-mcp": "dist/grid-mcp.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@grid/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "viem": "^2.37.0"
  }
}
