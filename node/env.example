# Copy to node/.env and edit. Every value has a default that works against a local anvil chain.

# 31337 = local anvil, 46630 = Robinhood Chain testnet, 4663 = Robinhood Chain
GRID_CHAIN_ID=31337
# GRID_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Private key of the host wallet: it lists the machine and receives the ETH.
# Defaults to anvil account #1 on chain 31337; required on every other chain.
# GRID_PRIVATE_KEY=0x...

# How the machine shows up in the market.
GRID_NAME=my-gpu-box
GRID_PRICE_PER_HOUR=0.001

# Where renters reach the HTTP API of this node (port GRID_PORT). Off a local chain it must be
# https:// (a Cloudflare tunnel, a Tailscale Funnel or a reverse proxy with a certificate):
# renters fetch their SSH password over it. GRID_ALLOW_HTTP=1 skips the check for experiments.
# Leave it unset (or set it to none) behind a router: the node is then reached through a relay
# and takes swarm work only.
GRID_PUBLIC_URL=http://127.0.0.1:7777
GRID_PORT=7777
# 127.0.0.1 when the API is only reached through a local tunnel.
# GRID_BIND=0.0.0.0

# Where renters SSH into. HTTPS tunnels do not carry SSH: forward GRID_SSH_PORT on your router and set
# GRID_SSH_HOST to your public IP or DNS name (defaults to the hostname of GRID_PUBLIC_URL).
# GRID_SSH_HOST=203.0.113.7
GRID_SSH_PORT=2222
# GPU hosts: docker build -t grid-rental node/rental-image, then GRID_DOCKER_IMAGE=grid-rental (the default
# image is Alpine and cannot run CUDA programs).
GRID_DOCKER_IMAGE=lscr.io/linuxserver/openssh-server:latest

# 1 = pretend to have a GPU and never start containers (demo mode).
# Unset = auto-detect: nvidia-smi for the GPU, docker for containers.
# GRID_SIMULATE=1

# Swarm work: between rentals the node takes tasks from swarm jobs. On wherever SwarmMarket is deployed.
# GRID_SWARM=0                 # stay out of the swarm
# GRID_SWARM_MIN_PRICE=0       # lowest ETH per run to accept
# GRID_SWARM_BATCH=4           # tasks claimed per round
# GRID_SWARM_NETWORK=1         # let task containers reach the network (off by default)

# Availability: offer the machine only in this window. Times are the machine's local time (set TZ, for example
# TZ=Europe/Berlin, to use another zone). Outside the window the node claims no new swarm tasks (ones already
# claimed finish) and marks the listing unavailable to new rentals; a rental that is running is never cut short.
# A window that runs past midnight belongs to the day it starts on. Unset = always on offer.
# GRID_HOURS=23-08             # hour range, 24-hour clock; 22:30-07:00 also works
# GRID_DAYS=mon-fri            # days or ranges: sat,sun  mon-wed,fri  all

# Self-pricing: while the machine sits idle its prices step down, and return to normal after a rental or a claimed task.
# GRID_AUTO_PRICE=1
# GRID_PRICE_STEP=3                # percent taken off per idle hour
# GRID_PRICE_FLOOR=0.0005          # lowest ETH per hour for rentals (default: half of GRID_PRICE_PER_HOUR)
# GRID_SWARM_MIN_PRICE_FLOOR=0     # lowest ETH per run for swarm work (default: half of GRID_SWARM_MIN_PRICE)

# Peer-to-peer network (libp2p). Peers listed on-chain are dialled automatically.
# GRID_P2P_PORT=4001
# GRID_P2P_ANNOUNCE=/dns4/gpu.example.com/tcp/4001   # derived from GRID_PUBLIC_URL when set
# GRID_BOOTSTRAP=/ip4/203.0.113.7/tcp/4001/p2p/12D3KooW...
# GRID_RELAY=1                 # relay for nodes behind routers (needs GRID_PUBLIC_URL)

# Seconds between chain checks.
GRID_POLL_SECONDS=5

# Contract addresses default to contracts/deployments/<chainId>.json
# GRID_MARKET_ADDRESS=0x...
# GRID_STAKE_ADDRESS=0x...
